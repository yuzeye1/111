# FrameLab 环境变量模板：复制为 .env 后修改

# 运行配置：development（默认，空库自动灌演示数据） / production（只建表，不灌数据）
FLASK_CONFIG=development

# 会话密钥（生产必须随机）
SECRET_KEY=change_me_to_random_string

# JWT 密钥（不设则沿用 SECRET_KEY）
JWT_SECRET_KEY=

# 数据库（开发默认 SQLite；生产可换 MySQL：
# mysql+pymysql://user:password@localhost:3306/framelab）
DATABASE_URL=

# 开发环境空库时是否自动灌本地演示数据（true/false，仅 development 生效）
AUTOSEED=true

# 阿里云邮件推送（验证码 / 找回密码）。不配置则开发环境直接回显验证码。
ALIYUN_SMTP_USER=noreply@ryanswb.cn
ALIYUN_SMTP_PASSWORD=
MAIL_DOMAIN=ryanswb.cn

# 生产首次部署自动创建的管理员账号（可选，留空则不创建）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM / 绘画模型 API（M3 后期接入，密钥不进代码库）
LLM_API_KEY=
IMAGE_API_KEY=
